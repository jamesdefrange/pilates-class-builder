  "flowRules": {
    "minSegmentMinutes": {
      "value": 8,
      "source": "assumption",
      "note": "No short hops. Time spent on one piece of equipment should be at least this long. Jay's example of a hop: 2 minutes on springboard then back to reformer."
    },
    "boxMinMinutes": {
      "value": 10,
      "source": "jay",
      "note": "Long box stays 10 minutes or more once placed."
    },
    "springDropCost": {
      "value": 0.5,
      "source": "jay",
      "note": "Dropping to a lighter spring (like for strap abs) is acceptable, so it counts half."
    },
    "standingHopCost": {
      "value": 0.3,
      "source": "assumption",
      "note": "Stepping off to stand is small but not free."
    },
    "defaultShares": {
      "value": {
        "reformer": 70,
        "chair": 15,
        "springboard": 10,
        "mat": 5,
        "bosu": 0
      },
      "source": "jay",
      "note": "Percent of class time when that equipment is ticked. Reformer includes time on the long box. Reformer about 70 percent and chair is Jay's favorite (jay). The rest are assumptions. Mat sparingly."
    }
